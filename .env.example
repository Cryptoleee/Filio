# Kopieer naar .env en vul in. Zie DEPLOY.md voor de NAS-installatie.
DATABASE_URL=postgresql://postgres@localhost:5432/filio
APP_URL=http://localhost:3000
SESSION_SECRET=vervang-door-lange-random-string

# Alleen voor docker compose:
DB_PASSWORD=vervang-door-random-string
REVIEW_DOMAIN=review.example.com

# Editor-account (aangemaakt door npm run seed)
EDITOR_EMAIL=editor@example.com
EDITOR_PASSWORD=kies-een-wachtwoord
EDITOR_NAME=Editor

# Immich (leeg = mock-modus: picker toont demobestanden, worker maakt testclips)
IMMICH_URL=
IMMICH_API_KEY=

# Waar de worker proxies en posters neerzet
PROXY_DIR=./data/proxies

# Mail (leeg = digest alleen naar de console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
